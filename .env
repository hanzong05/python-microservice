# Database Configuration
DATABASE_URL=postgresql://postgres.your-project:password@db.supabase.co:5432/postgres

# PostGIS Configuration
POSTGIS_SRID=4326  # WGS84 coordinate system

# File Upload Configuration
EXCEL_INPUT_DIR=./data/input
EXCEL_OUTPUT_DIR=./data/output
BACKUP_DIR=./data/backups

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/data_upload.log

# Upload Configuration
BATCH_SIZE=1000
MAX_RETRIES=3
RETRY_DELAY=5

# Data Cleaning Configuration
HANDLE_MISSING_VALUES=true
REMOVE_DUPLICATES=true
VALIDATE_BEFORE_UPLOAD=true
NULL_THRESHOLD=0.5  # Drop columns with >50% nulls

# PostGIS Configuration
GEOMETRY_COLUMN_NAME=location
COORDINATE_SYSTEM=EPSG:4326
VALIDATE_COORDINATES=true
